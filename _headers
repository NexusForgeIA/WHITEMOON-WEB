# Assets estáticos — caché 1 año, inmutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Regla explícita (asegura cobertura aunque /assets/* ya cubre via glob)
/assets/site.css
  Cache-Control: public, max-age=31536000, immutable

# Widget de chatbot en raíz (no en /assets/)
